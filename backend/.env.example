# WeatherGPT backend configuration. Copy to .env for local runs; on Vercel set these as
# project environment variables. Values starting with "your_" count as unset.
# NEVER put any of these in the mobile or web apps — they stay server-side.

# ---------------------------------------------------------------------------
# Forecast chain (default: imd,weathernext,open_meteo). Providers left out are not used.
# WEATHER_PROVIDER_PRIORITY=imd,weathernext,open_meteo
# WEATHER_SUPPLEMENT_ENABLED=1   # fill null fields (hourly, rain chance, UV, AQI, sun times) from Open-Meteo
# WEATHER_ALERTS_ENABLED=1       # official warnings (IMD + NDMA SACHET) in /v2/weather and chat

# ---------------------------------------------------------------------------
# IMD API gateway (https://api.imd.gov.in). Both values are required; the gateway
# also whitelists the caller's egress IP, so register the server's IP with IMD.
IMD_API_KEY=your_imd_api_key
IMD_JWT_TOKEN=your_imd_jwt_token
# IMD_BASE_URL=https://api.imd.gov.in/api/v1
# IMD_MAX_STATION_KM=35                 # nearest city station must be within this distance
# IMD_OBSERVATION_MAX_AGE_HOURS=3       # older station observations are not shown as "now"
# IMD_TIMEOUT_SECONDS=8
# Paths for the 8 APIs whose docs are behind the IMD portal login (see GET /v2/imd):
# IMD_ENDPOINT_AGROMET=...
# IMD_ENDPOINT_RADAR=...
# IMD_ENDPOINT_LIGHTNING=...
# IMD_ENDPOINT_MAUSAMGRAM=...
# IMD_ENDPOINT_FISHERMEN_WARNING=...
# IMD_ENDPOINT_HIGHWAY_NOWCAST=...
# IMD_ENDPOINT_HIGHWAY_WARNING=...
# IMD_ENDPOINT_ALL_INDIA_BULLETIN=...

# ---------------------------------------------------------------------------
# Google DeepMind WeatherNext via BigQuery (optional)
# WEATHERNEXT_ENABLED=1
# GOOGLE_CLOUD_PROJECT=your_gcp_project          # billing/quota project for the BigQuery jobs
# WEATHERNEXT_TABLE_3=project.dataset.weathernext_3_0_0_0p1deg
# WEATHERNEXT_TABLE_3_HR=project.dataset.weathernext_3_0_0_0p05deg   # station-head schema, opt-in
# WEATHERNEXT_TABLE_2=project.dataset.weathernext_2_0_0_mean         # only used when model=weathernext_2
# WEATHERNEXT_BQ_COLUMN_PROFILE=standard         # minimal | standard | extended
# WEATHERNEXT_BQ_MAX_BYTES_BILLED=107374182400   # checked against BigQuery's PRE-pruning estimate
# WEATHERNEXT_BQ_LOCATION=US
# WEATHERNEXT_QUERY_TIMEOUT_SECONDS=25           # keep below Vercel maxDuration (60 s)
# WEATHERNEXT_FRESHNESS_HOURS=24                 # newest usable run is normally 7-13 h old
# WEATHERNEXT_DELIVERY_LATENCY_HOURS=7
# WEATHERNEXT_MAX_RUN_ATTEMPTS=3
# WEATHERNEXT_MOCK_DATA=1                        # offline dev only: labelled synthetic data
# Credentials, first usable wins:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}   # recommended on Vercel
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json         # a PATH, not JSON
# GOOGLE_OAUTH_CLIENT_ID= / GOOGLE_OAUTH_CLIENT_SECRET= / GOOGLE_OAUTH_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Chat (Groq). Without a key, chat answers deterministically from live data.
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
# CHAT_TIMEOUT_SECONDS=22
# CHAT_FAST_PATH=1          # simple weather asks skip the agent (answer from live data)

# ---------------------------------------------------------------------------
# Bhashini speech (MeitY ULCA) for /v2/speech/*. Unset = apps use on-device speech.
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_ULCA_API_KEY=your_bhashini_ulca_api_key
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# ---------------------------------------------------------------------------
# TypeSafe System One (optional: intent routing + advisory scoring)
# TYPESAFE_API_KEY=your_typesafe_api_key
# TYPESAFE_ADVISORY_MIN_CONFIDENCE=0.55
# TYPESAFE_INTENT_MIN_CONFIDENCE=0.55

# ---------------------------------------------------------------------------
# Operator routes (GET /dev/imd/probe, POST /dev/reset) need header X-Admin-Token.
# ADMIN_TOKEN=choose_a_long_random_string
# NOMINATIM_USER_AGENT=WeatherGPT/3.0 (+contact-url)   # OSM policy: identify the app
