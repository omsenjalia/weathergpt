# Required: Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model ID. Must be one your key has access to.
# Defaults to openai/gpt-oss-120b (high precision multilingual reasoning & rich widget formatting).
GROQ_MODEL=openai/gpt-oss-120b

# --- Provider Priority (new) ---
# New priority: IMD (when configured) → WeatherNext → AccuWeather → Open-Meteo fallback
# Legacy fusion (Open-Meteo > AccuWeather > others) retained as diagnostic.
WEATHER_PROVIDER_PRIORITY=imd,weathernext,accuweather,open_meteo
# FUSION_PROVIDER_TIMEOUT=6      # seconds per provider (all providers run in parallel)
# FUSION_OUTLIER_DELTA_C=7       # exclude vendors deviating more than this from Open-Meteo

# --- Secondary-field supplement ---
# WeatherNext/IMD/AccuWeather forecasts do not carry sunrise/sunset, UV or air
# quality (and a minimal BigQuery column profile omits humidity/pressure/cloud).
# /v2/weather and /weather fill ONLY those null fields from Open-Meteo and
# attribute every filled field in `field_sources` (primary values are never
# overwritten). Set to 0 to disable (offline demos, tests).
# WEATHER_SUPPLEMENT_ENABLED=1

# --- Multi-Source Weather Provider Keys ---
# Placeholder values starting with "your_" are ignored.
ACCUWEATHER_KEY=your_accuweather_key_here
WEATHERAPI_KEY=your_weatherapi_key_here
TOMORROW_KEY=your_tomorrow_io_key_here
OPENWEATHER_KEY=your_openweather_key_here

# --- Official IMD Portal Direct REST API Credentials ---
# Used by services/providers/imd.py for direct portal authentication when key is approved.
# In absence of these keys, system automatically falls back to live IMD CAP RSS alerts.
IMD_API_KEY=your_official_imd_api_key_here
IMD_JWT_TOKEN=your_official_imd_jwt_token_here

# --- WeatherNext 3 (Google DeepMind) via BigQuery ---
# Live path: services/weathernext_bigquery.py runs ONE bounded point query per
# (table, run, 0.1 deg cell) and caches it. Anything that fails falls back to
# Open-Meteo with an explicit fallback_reason (never a crash, never silent).
# WEATHERNEXT_ENABLED=1
# WEATHERNEXT_SURFACE=bigquery
# GOOGLE_CLOUD_PROJECT=cool-archery-296710        # billing/quota project for the BigQuery jobs
# GOOGLE_CLOUD_QUOTA_PROJECT=cool-archery-296710  # optional, defaults to GOOGLE_CLOUD_PROJECT
# Model-specific tables (set all three when the project has the nine grants)
# WEATHERNEXT_TABLE_3=cool-archery-296710.weathernext.weathernext_3_0_0_0p1deg
# WEATHERNEXT_TABLE_3_HR=cool-archery-296710.weathernext.weathernext_3_0_0_0p05deg
# WEATHERNEXT_TABLE_2=cool-archery-296710.weathernext.weathernext_2_0_0_0p1deg
# WEATHERNEXT_TABLE is retained as the WN3 0.1 degree alias.
# WEATHERNEXT_TABLE=cool-archery-296710.weathernext.weathernext_3_0_0_0p1deg
#   (alias of WEATHERNEXT_BQ_SURFACE_TABLE; the ..._0p05deg table carries the
#    station_head_* columns and is ~4x the bytes per query)
# WEATHERNEXT_BQ_LOCATION=US
# WEATHERNEXT_BQ_COLUMN_PROFILE=standard   # minimal|standard|extended - which forecast.* leaves to SELECT
# WEATHERNEXT_BQ_MAX_BYTES_BILLED=107374182400
#   Per-job hard cap (default 100 GiB). BigQuery validates the cap against the
#   PRE-pruning estimate of the referenced columns for the init_time partition
#   (tens of GiB), even though the geography clustering means far fewer bytes
#   are actually scanned/billed. A 1 GiB cap therefore rejects every query
#   with bytes_billed_limit_exceeded; the effective cost per query is small.
# WEATHERNEXT_QUERY_TIMEOUT_SECONDS=25     # keep below the Vercel maxDuration (60 s)
# WEATHERNEXT_NEAREST_RADIUS_KM=9          # ST_DWITHIN radius used to find the nearest cell centre
#
# Run policy (WeatherNext 3 inits hourly; 00/06/12/18Z carry the 15-day horizon
# and land on BigQuery ~7 h after init, so the newest usable run is 7-13 h old).
# WEATHERNEXT_RUN_HOURS=0,6,12,18
# WEATHERNEXT_DELIVERY_LATENCY_HOURS=7
# WEATHERNEXT_MAX_RUN_ATTEMPTS=3           # older runs to try when the newest is not there yet
# WEATHERNEXT_FRESHNESS_HOURS=24           # fresh <= 24 h, stale <= 48 h, expired beyond
# WEATHERNEXT_CACHE_TTL_SECONDS=3600
# WEATHERNEXT_MAX_HORIZON_HOURS=360
#
# Credentials - tried in this order (first usable wins, see /v2/weather/health):
#  1. GOOGLE_APPLICATION_CREDENTIALS_JSON  full service-account JSON as ONE env value
#                                          (recommended for Vercel; never commit the file)
#  2. GOOGLE_APPLICATION_CREDENTIALS       path to a service-account file, or any
#                                          Application Default Credentials (workload identity)
#  3. GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET / GOOGLE_OAUTH_REFRESH_TOKEN
#                                          user OAuth refresh token (legacy, dev only)
# The service account needs roles/bigquery.jobUser on the project and read
# access to the WeatherNext dataset. Scope requested: https://www.googleapis.com/auth/bigquery
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"cool-archery-296710",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # file path, NOT JSON content
# GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
# GOOGLE_OAUTH_REDIRECT_URI=https://your.app/callback
# WEATHERNEXT_AUTH_MODE=adc    # adc|oauth - legacy hint only; the chain above always runs
#                              # (on Vercel the ambient-ADC metadata probe is skipped)
# WEATHERNEXT_MOCK_DATA=1      # offline/dev only: synthetic ensemble instead of BigQuery
#
# Other (unused by the BigQuery path, kept for the GCS/EE surfaces):
# WEATHERNEXT_BQ_STATION_TABLE=cool-archery-296710.weathernext.weathernext_3_0_0_0p05deg
# WN3 roots can be supplied as full Zarr URIs or bucket aliases from the plan.
# WEATHERNEXT_GCS_BUCKET_3=weathernext3_spatial
# WEATHERNEXT_GCS_STATS_3=weathernext3_statistics_spatial
# WEATHERNEXT_GCS_BUCKET_2=weathernext2_spatial
# WEATHERNEXT_GCS_STATS_2=weathernext2_statistics_spatial
# WEATHERNEXT_GCS_ENSEMBLE_ROOT=gs://weathernext3_spatial/weathernext_3_0_0/zarr/
# WEATHERNEXT_GCS_STATISTICS_ROOT=gs://weathernext3_statistics_spatial/weathernext_3_0_0_statistics/zarr/
# WEATHERNEXT_GCS_USER_PROJECT=your-gcp-project-id
# WEATHERNEXT_EE_PROJECT=your-ee-project

# --- Chat / Agent Tuning ---
# CHAT_TIMEOUT_SECONDS=22        # LangGraph agent budget before deterministic fallback
# CHAT_FAST_PATH=1               # 0 = always run the agent for weather questions
# WEATHER_MODE=everyone          # everyone|farmer|researcher (request-scoped, env is default)

# --- TypeSafe System One (Jev) — typed decisions ---
# Keys stay SERVER-SIDE only. Get one at https://console.typesafe.ai/settings/keys
# Without a key the backend silently uses deterministic keyword/threshold logic.
TYPESAFE_API_KEY=your_typesafe_api_key_here
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TYPESAFE_ENABLED=1                # 0 hard-disables even with a key present
# TYPESAFE_TIMEOUT_SECONDS=4        # per-attempt timeout
# TYPESAFE_MAX_ATTEMPTS=3           # retries on 429/5xx/network errors
# TYPESAFE_RETRY_BACKOFF_SECONDS=0.4
# TYPESAFE_CHAT_ROUTING=1           # 0 = keep keyword-only chat intent routing
# TYPESAFE_INTENT_MIN_CONFIDENCE=0.55   # below this, keywords decide
# TYPESAFE_ADVISORY_MIN_CONFIDENCE=0.55 # below this, threshold bands stand
# TYPESAFE_ABUSE_MIN_PROBABILITY=0.85  # abuse probe (rides in intent call) above this -> guarded reply
# TYPESAFE_REPLY_CHECK=0              # 1 = Noul-gate agent replies; extreme non-answers fall back
# TYPESAFE_REPLY_MIN_PROBABILITY=0.15 # reply gate veto threshold
# TYPESAFE_REPLY_TIMEOUT_SECONDS=3
# TYPESAFE_LOG_CALLS=0                # 1 = INFO-log every successful System One call (visible in /dev)

# --- Jev Decision Platform Expansion ---
# TYPESAFE_WEATHERNEXT_MODE=off       # off|shadow|enforce - controls WeatherNext Jev routing
# TYPESAFE_DECISION_FEATURES=          # comma-separated allowlist, empty = all enabled per mode
# TYPESAFE_TOTAL_BUDGET_MS=4000       # total budget for Jev calls per request
# TYPESAFE_MAX_CALLS_PER_REQUEST=2    # max Jev calls per request
# TYPESAFE_MAX_QUESTIONS_PER_CALL=24  # max questions per Jev call
# TYPESAFE_MAX_STATE_CHARS=7000       # max state chars (compact state bound)
# TYPESAFE_DECISION_AUDIT_ENABLED=1   # audit store enabled
# TYPESAFE_DECISION_AUDIT_RETENTION_DAYS=7
# TYPESAFE_DECISION_LOG_RAW_PAYLOADS=0 # 1 = log raw payloads (security risk, off by default)
