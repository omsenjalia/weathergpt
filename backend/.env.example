# Required: Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model ID. Must be one your key has access to.
# Defaults to openai/gpt-oss-120b (high precision multilingual reasoning & rich widget formatting).
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Multi-Source Ensemble Weather Provider Keys
# Fusion priority: Open-Meteo (2.0, built-in, no key) > AccuWeather (1.5) >
# WeatherAPI (1.2) = Tomorrow.io (1.2) > OpenWeatherMap (1.1).
# Placeholder values starting with "your_" are ignored.
ACCUWEATHER_KEY=your_accuweather_key_here
WEATHERAPI_KEY=your_weatherapi_key_here
TOMORROW_KEY=your_tomorrow_io_key_here
OPENWEATHER_KEY=your_openweather_key_here

# Optional: fusion tuning
# FUSION_PROVIDER_TIMEOUT=6      # seconds per provider (all providers run in parallel)
# FUSION_OUTLIER_DELTA_C=7       # exclude vendors deviating more than this from Open-Meteo
# CHAT_TIMEOUT_SECONDS=22        # LangGraph agent budget before deterministic fallback
# CHAT_FAST_PATH=1               # 0 = always run the agent for weather questions

# Optional: Official IMD Portal Direct REST API Credentials (Roadmap Integration)
# Used by imd_service.py for direct portal authentication when key is approved.
# In absence of these keys, system automatically falls back to live IMD CAP RSS alerts.
IMD_API_KEY=your_official_imd_api_key_here
IMD_JWT_TOKEN=your_official_imd_jwt_token_here
