# Required: Windy MAP FORECAST API key — used by MapView.jsx (windyInit).
# Get one free at https://api.windy.com/keys
VITE_WINDY_API_KEY=your_windy_map_forecast_key_here

# OpenWeatherMap API key — used for weather map tile layers.
# Get one free at https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY=your_openweathermap_key_here

# Required for Vercel (or any non-local deployment): URL of the hosted backend.
# Set this in Vercel → Project → Settings → Environment Variables.
# Must use https:// — no trailing slash.
VITE_API_URL=https://your-backend.vercel.app

# Optional: Client-Side Multi-Source Ensemble Provider Keys
# Open-Meteo (ECMWF/IMD standard model) is built-in with zero configuration required.
# Ingest additional keys below for 5-provider client-side ensemble fusion:
VITE_WEATHERAPI_KEY=your_weatherapi_key_here
VITE_TOMORROW_KEY=your_tomorrow_key_here
VITE_OPENWEATHER_KEY=your_openweather_key_here
VITE_ACCUWEATHER_KEY=your_accuweather_key_here
